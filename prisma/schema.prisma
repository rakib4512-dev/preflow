generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum Plan {
  FREE
  GROWTH
  PRO
}

model Shop {
  id             String    @id @default(cuid())
  shop           String    @unique
  plan           Plan      @default(FREE)
  usageThisCycle Int       @default(0)
  cycleStart     DateTime  @default(now())
  settings       Json      @default("{}")
  uninstalledAt  DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  preorderConfigs       PreorderConfig[]
  preorderOrders        PreorderOrder[]
  billingEvents         BillingEvent[]
  customerNotifications CustomerNotification[]
}

// variantId = "" means product-level (all variants). Non-empty = variant GID.
model PreorderConfig {
  id             String    @id @default(cuid())
  shopId         String
  productId      String
  variantId      String    @default("")
  enabled        Boolean   @default(false)
  message        String    @default("Pre-order now")
  shipDate       DateTime?
  sellingPlanGid String?
  // Numeric ID of the selling plan inside the group — what the storefront
  // submits as the `selling_plan` cart parameter.
  sellingPlanId  String?
  // GID of the automatic percentage discount scoped to this product. null
  // means no discount configured for this pre-order.
  discountGid    String?
  // Discount percentage (0-100). 0 / null = no discount.
  discountPercent Int?
  // Variant inventory policies captured before we set CONTINUE, so disable
  // can restore the merchant's original settings. [{ id, policy }]
  policySnapshot Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId, variantId])
  @@index([shopId, enabled])
}

model PreorderOrder {
  id        String   @id @default(cuid())
  shopId    String
  orderGid  String   @unique
  lineItems Json
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

enum BillingEventType {
  USAGE_WARNING_70
  USAGE_WARNING_100
  OVERAGE_BILLED
  PLAN_CHANGED
  PLAN_CANCELLED
}

model BillingEvent {
  id        String           @id @default(cuid())
  shopId    String
  type      BillingEventType
  payload   Json
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, type])
}

model CustomerNotification {
  id        String   @id @default(cuid())
  shopId    String
  orderGid  String
  type      String
  payload   Json
  dedupeKey String   @unique
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, orderGid])
}

// Idempotency table — keyed on Shopify X-Shopify-Webhook-Id header
model ProcessedWebhook {
  webhookId String   @id
  topic     String
  shop      String
  createdAt DateTime @default(now())

  @@index([shop])
}
